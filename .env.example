# Copy to .env and fill in. Never commit .env.
# LLM: any OpenAI-compatible API. Default setup = Google Gemini (free tier,
# key from https://aistudio.google.com/apikey).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-flash-lite-latest

# Optional overrides (defaults shown)
# WHISPER_MODEL=small
# WAKE_WORDS=apolo,apollo
# WAKE_MATCH_THRESHOLD=0.7
# PIPER_MODEL=../piper/models/pt_BR-faber-medium.onnx
# TTS_PITCH_SEMITONES=2
# CLEAN_AUDIO=0
# DEBUG_SAVE_AUDIO=0
# APOLLO_PORT=1969
